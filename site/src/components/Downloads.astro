---
import { buildCards, splitCode } from "../lib/download-cards";
import { RELEASES_URL, type ReleaseDownloads } from "../lib/releases";

interface Props {
  downloads: ReleaseDownloads | null;
}

const { downloads } = Astro.props;
const cards = buildCards(downloads);
const checksumsUrl = downloads?.checksums?.url ?? RELEASES_URL;
---

<section id="download" aria-labelledby="dl-title" class="section">
  <div class="container inner">
    <div class="head">
      <h2 id="dl-title">
        Download Rebasar<span class="beta mono">Beta</span>
      </h2>
      <p>
        Pick your platform.
        {downloads && <span class="version mono">v{downloads.version}</span>}
      </p>
    </div>
    <div class="cards">
      {
        cards.map((card) => (
          <article
            class:list={["card", { recommended: card.os === "Windows", later: card.id === "macos" }]}
            data-recommended-for={card.os}
          >
            <div class="badge mono">Recommended for your system</div>
            <h3>{card.name}</h3>
            {card.file && <div class="file mono">{card.file}</div>}
            <p class="note">
              {splitCode(card.note).map((part) => (part.code ? <span class="inline-code">{part.text}</span> : part.text))}
            </p>
            {card.href && (
              <a href={card.href} class="download" aria-label={`Download ${card.name}`}>
                Download
              </a>
            )}
          </article>
        ))
      }
    </div>
    <p class="checksums">
      Every release lists a <a href={checksumsUrl} class="inline-code">SHA256SUMS</a> file to check your download against.
    </p>

    <div class="install">
      <details open>
        <summary>
          Before you install
          <span class="toggle mono" aria-hidden="true"></span>
        </summary>
        <div class="install-body">
          <div class="install-row">
            <span class="where mono">git</span>
            <p>
              Rebasar needs a system <span class="inline-code">git</span> 2.35.0 or newer, and shows a setup screen
              when it is missing or older. (Ubuntu 22.04 ships 2.34; install a newer one from the Git PPA.)
            </p>
          </div>
          <div class="install-row">
            <span class="where mono">Windows</span>
            <p>
              The Windows installer is not code-signed yet, so SmartScreen may show "Windows protected your PC".
              Choose <b>More info</b>, then <b>Run anyway</b>.
            </p>
          </div>
          <div class="install-row">
            <span class="where mono">Linux</span>
            <p>
              Linux doesn't store credentials yet: to use GitHub pull requests there, sign in with the GitHub CLI
              (<span class="inline-code">gh auth login</span>).
            </p>
          </div>
        </div>
      </details>
    </div>
    <p class="all"><a href={downloads?.releaseUrl ?? RELEASES_URL} class="text-link">All releases and checksums on GitHub →</a></p>
  </div>
</section>

<style>
  .inner {
    border-top: 1px solid var(--color-border);
    padding-top: clamp(48px, 7vw, 88px);
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  h2 {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 16px;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .beta {
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--color-accent-surface);
    color: var(--color-accent-text);
    font-size: 0.3em;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .head p {
    font-size: 18px;
    color: var(--color-text-muted);
  }

  .version {
    margin-left: 8px;
    font-size: 14px;
    color: var(--color-text-subtle);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    gap: 12px;
  }

  /* A single column keeps the full "Recommended for your system" badge on one line. */
  @media (max-width: 519px) {
    .cards {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }
  }

  .card {
    position: relative;
    padding: 18px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .card.recommended {
    background: oklch(0.24 0.03 250);
    border-color: var(--color-accent);
  }

  .card.later {
    background: transparent;
    border: 1px dashed var(--color-border-strong);
    color: var(--color-text-muted);
  }

  .badge {
    display: none;
    position: absolute;
    top: -11px;
    left: 14px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }

  .card.recommended .badge {
    display: block;
  }

  h3 {
    font-size: 16px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .later h3 {
    color: var(--color-text-muted);
  }

  .file {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .note {
    font-size: 13.5px;
    line-height: 1.5;
    color: oklch(0.78 0.02 265);
    overflow-wrap: anywhere;
  }

  .later .note {
    color: var(--color-text-muted);
  }

  .note .inline-code {
    font-size: 0.92em;
  }

  .download {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-hover);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-strong);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }

  .recommended .download {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .download:hover {
    filter: brightness(1.12);
  }

  .download:active {
    filter: brightness(0.92);
    transform: translateY(1px);
  }

  .checksums,
  .all {
    margin-top: 22px;
    text-align: center;
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .install {
    max-width: 820px;
    margin: 28px auto 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
  }

  summary {
    min-height: 56px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--color-text-strong);
    font: 600 16px var(--font-ui);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: var(--color-surface-raised);
  }

  summary:focus-visible {
    outline-offset: -2px;
  }

  .toggle {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    display: grid;
    place-items: center;
    font-size: 15px;
    line-height: 1;
    color: var(--color-text-muted);
  }

  .toggle::before {
    content: "+";
  }

  details[open] .toggle::before {
    content: "−";
  }

  .install-body {
    border-top: 1px solid var(--color-border);
    padding: 6px 20px 18px;
    display: flex;
    flex-direction: column;
  }

  .install-row {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .install-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .where {
    flex: none;
    width: 64px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.9;
    color: var(--color-accent);
  }

  .install-row p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-soft);
    text-wrap: pretty;
  }

  .install-row b {
    color: var(--color-text-strong);
  }
</style>
