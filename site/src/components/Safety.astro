---
import { lossRows } from "../data/sample";

const points = [
  { code: "", text: "Exact loss, stated up front" },
  { code: "--force-with-lease", text: ", always" },
  { code: "", text: "Your hooks, your signing, your config" },
];
---

<section aria-labelledby="safe-title" class="section">
  <div class="container layout">
    <div>
      <h2 id="safe-title" class="heading-xl">Powerful Git, no surprises.</h2>
      <p class="lede">
        Before anything that can lose work runs, Rebasar tells you exactly what's about to vanish. Force-push
        always uses <span class="inline-code">--force-with-lease</span>. And because Rebasar runs your own
        <span class="inline-code">git</span>, your hooks, signing and credential helpers behave the way they do
        in your terminal.
      </p>
      <ul>
        {
          points.map((point) => (
            <li>
              <span class="tick" aria-hidden="true">✓</span>
              <span>
                {point.code && <span class="mono flag">{point.code}</span>}
                {point.text}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="stage mock" aria-hidden="true">
      <div class="scrim"></div>
      <div class="dialog">
        <div class="dialog-head">
          <span class="bang">!</span>
          <div class="dialog-title">Discard changes in 4 files?</div>
        </div>
        <div class="muted">This will permanently lose:</div>
        <div class="loss">
          {
            lossRows.map((row) => (
              <div class="loss-row">
                <span class="count mono">{row.count}</span>
                <span class="what">{row.text}</span>
                <span class="file mono">{row.file}</span>
              </div>
            ))
          }
        </div>
        <div class="fine">
          Rebasar has no undo. Anything already committed can still be recovered through Git's reflog;
          uncommitted lines cannot.
        </div>
        <div class="buttons"><span class="cancel">Cancel</span><span class="discard">Discard 4 files</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  h2 {
    margin-bottom: 16px;
  }

  .lede {
    max-width: 520px;
    margin-bottom: 28px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .lede .inline-code {
    font-size: 0.88em;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 17px;
    line-height: 1.4;
    color: var(--color-text-strong);
  }

  .flag {
    font-size: 0.9em;
  }

  .tick {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--color-accent-surface);
    color: var(--color-accent-text);
    display: grid;
    place-items: center;
    font: 600 13px/1 var(--font-ui);
    flex: none;
  }

  .stage {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    overflow: hidden;
    padding: clamp(14px, 3vw, 32px);
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: var(--color-scrim);
  }

  .dialog {
    position: relative;
    max-width: 460px;
    margin: 0 auto;
    border-radius: 16px;
    background: var(--color-surface-raised);
    border: 1px solid oklch(0.34 0.04 25);
    box-shadow: 0 24px 64px oklch(0 0 0 / 0.5);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .dialog-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bang {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: oklch(0.72 0.17 25 / 0.16);
    color: var(--color-danger);
    display: grid;
    place-items: center;
    font: 700 17px/1 var(--font-ui);
  }

  .dialog-title {
    font: 600 18px/1.3 var(--font-ui);
    color: var(--color-text-strong);
  }

  .muted {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .loss {
    border-radius: var(--radius-md);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .loss-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    padding: 9px 12px;
    border-top: 1px solid var(--color-divider);
  }

  .loss-row:first-child {
    border-top: 0;
  }

  .count {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-danger);
  }

  .what {
    font-size: 12.5px;
    color: var(--color-text);
  }

  .file {
    font-size: 12px;
    color: oklch(0.78 0.02 265);
  }

  .fine {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .buttons {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .buttons span {
    padding: 9px 16px;
    border-radius: 9px;
  }

  .cancel {
    background: var(--color-hover);
    border: 1px solid var(--color-accent);
    color: var(--color-text-strong);
    font-weight: 500;
  }

  .discard {
    background: var(--color-danger-strong);
    color: var(--color-on-danger);
    font-weight: 600;
  }
</style>
