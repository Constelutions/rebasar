---
import { stats } from "../data/sample";
import { REPOSITORY_URL } from "../lib/releases";
---

<section id="performance" aria-labelledby="perf-title" class="perf">
  <div class="container">
    <h2 id="perf-title" class="visually-hidden">Performance</h2>
    <div class="grid">
      {
        stats.map((stat) => (
          <div class="tile">
            <div class="number mono">
              {stat.value}<span class="unit">{stat.unit}</span>
            </div>
            <div class="label">{stat.label}</div>
            <div class="target mono">{stat.target}</div>
          </div>
        ))
      }
    </div>
    <p class="footnote">
      Measured on an Intel Core i9-12900K with 48 GB RAM, Windows 11.{" "}
      <a href={`${REPOSITORY_URL}/blob/main/docs/benchmark-report.md`} class="text-link">Read the full benchmark report →</a>
    </p>
  </div>
</section>

<style>
  .perf {
    padding: clamp(28px, 4vw, 48px) var(--gutter) clamp(56px, 8vw, 96px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    gap: 12px;
  }

  .tile {
    padding: clamp(16px, 2vw, 26px);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .number {
    font-size: clamp(36px, 4.6vw, 60px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-text-strong);
  }

  .unit {
    font-size: 0.42em;
    letter-spacing: 0;
    color: var(--color-accent);
    margin-left: 0.25em;
  }

  .label {
    font-size: 15px;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .target {
    margin-top: auto;
    padding-top: 6px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-text-subtle);
  }

  .footnote {
    margin-top: 20px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-subtle);
    text-wrap: pretty;
  }
</style>
