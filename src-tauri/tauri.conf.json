{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rebasar",
  "version": "0.1.0",
  "identifier": "dev.constelutions.rebasar",
  "build": {
    "beforeDevCommand": "pnpm --filter @rebasar/ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @rebasar/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "title": "Rebasar", "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
