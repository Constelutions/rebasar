{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rebasar",
  "mainBinaryName": "rebasar-app",
  "identifier": "dev.constelutions.rebasar",
  "build": {
    "beforeDevCommand": "pnpm --filter @rebasar/ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @rebasar/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "title": "Rebasar", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 560, "decorations": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "license": "Apache-2.0",
    "publisher": "Constelutions",
    "copyright": "Copyright (c) Constelutions",
    "category": "DeveloperTool",
    "shortDescription": "A fast desktop Git client for many repositories, branches, worktrees and pull requests.",
    "longDescription": "Rebasar is a fast, cross-platform desktop Git client for developers who work across many repositories, branches and worktrees at the same time.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
